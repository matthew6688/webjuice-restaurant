---
import { loadCheckoutArtifact } from '../lib/restaurantArtifacts';

const checkout = loadCheckoutArtifact();
const tiers = checkout.tiers || [];
const oneTime = tiers.find((tier: any) => tier.id === 'one_time') || tiers[0];
const yearly = tiers.find((tier: any) => tier.id === 'yearly_maintenance') || tiers[1];
const hasSalesBar = Boolean(oneTime?.purchaseUrl || yearly?.purchaseUrl || checkout.feedbackUrl);
const hidden = checkout.hiddenFields || {};
const clientSlug = hidden.client_slug || checkout.clientSlug || '';
const repo = hidden.repo || '';
const previewUrl = hidden.preview_url || '';
const infoParams = new URLSearchParams({
  client_slug: clientSlug,
  repo,
  preview_url: previewUrl,
});
const faqUrl = `/demo-faq?${infoParams.toString()}`;
---

{hasSalesBar && (
  <aside
    class="preview-sales-bar"
    aria-label="Preview claim and order actions"
    data-preview-sales-bar
    data-client-slug={clientSlug}
    data-repo={repo}
    data-preview-url={previewUrl}
  >
    <div class="preview-sales-inner">
      <div class="preview-sales-copy">
        <span class="preview-sales-mark" aria-hidden="true"></span>
        <span class="preview-sales-brand">profitslocal</span>
      </div>
      <nav class="preview-sales-actions" aria-label="Preview purchase and feedback links">
        {oneTime?.purchaseUrl && (
          <a class="preview-sales-plan preview-sales-plan-featured" href={oneTime.purchaseUrl} target="_blank" data-sales-mode>
            <span>${oneTime.amount} one-time</span>
            <small>3 revisions + hosting + subdomain</small>
          </a>
        )}
        {yearly?.purchaseUrl && (
          <a class="preview-sales-plan" href={yearly.purchaseUrl} target="_blank" data-sales-mode>
            <span>${yearly.amount}/year</span>
            <small>12 revisions + maintenance + SEO</small>
          </a>
        )}
        <a class="preview-sales-plan" href="/checkout?tier=extra_revision" data-sales-mode>
          <span>$100 extra revision</span>
          <small>Only after quota is used</small>
        </a>
        <a class="preview-sales-link" href={faqUrl} data-sales-mode>How it works</a>
        <a class="preview-sales-checkout" href={oneTime?.purchaseUrl || yearly?.purchaseUrl || faqUrl} target="_blank" data-sales-mode>Checkout</a>
        <a class="preview-sales-plan preview-sales-plan-featured is-hidden" href="/approve" data-order-mode data-approve-link>
          <span>Approve site</span>
          <small>publish live</small>
        </a>
        <a class="preview-sales-plan is-hidden" href="/revise" data-order-mode data-revise-link>
          <span>Request revision</span>
          <small data-revision-usage>check quota</small>
        </a>
        <a class="preview-sales-link is-hidden" href="/domain-setup" data-order-mode data-domain-link>Domain setup</a>
        <a class="preview-sales-link is-hidden" href="/checkout?tier=extra_revision" data-order-mode data-extra-link>Buy extra revision</a>
        {checkout.feedbackUrl && (
          <a class="preview-sales-link" href={checkout.feedbackUrl} target="_blank" data-sales-mode>Request changes</a>
        )}
      </nav>
    </div>
  </aside>
)}

<script>
  const bar = document.querySelector('[data-preview-sales-bar]');
  if (bar) {
    const params = new URLSearchParams(window.location.search);
    const orderId = params.get('order_id') || params.get('session_id') || '';
    const email = params.get('email') || '';
    const clientSlug = bar.getAttribute('data-client-slug') || params.get('client_slug') || '';
    const repo = bar.getAttribute('data-repo') || params.get('repo') || '';
    const previewUrl = bar.getAttribute('data-preview-url') || window.location.origin;
    if (orderId && email) {
      const shared = new URLSearchParams({
        order_id: orderId,
        email,
        client_slug: clientSlug,
        repo,
        preview_url: previewUrl,
      });
      bar.querySelectorAll('[data-sales-mode]').forEach((element) => element.classList.add('is-hidden'));
      bar.querySelectorAll('[data-order-mode]').forEach((element) => element.classList.remove('is-hidden'));
      const title = bar.querySelector('[data-sales-title]');
      const subtitle = bar.querySelector('[data-sales-subtitle]');
      const approve = bar.querySelector('[data-approve-link]');
      const revise = bar.querySelector('[data-revise-link]');
      const extra = bar.querySelector('[data-extra-link]');
      const domain = bar.querySelector('[data-domain-link]');
      if (title) title.textContent = 'Review controls';
      if (subtitle) subtitle.textContent = 'Approve or request changes from this dev preview';
      if (approve) approve.setAttribute('href', `/approve?${shared.toString()}`);
      if (revise) revise.setAttribute('href', `/revise?${shared.toString()}`);
      if (domain) domain.setAttribute('href', `/domain-setup?${shared.toString()}`);
      if (extra) {
        const extraParams = new URLSearchParams(shared);
        extraParams.set('tier', 'extra_revision');
        extra.setAttribute('href', `/checkout?${extraParams.toString()}`);
      }
      fetch('/api/order-status/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ order_id: orderId, email, client_slug: clientSlug, repo }),
      })
        .then((response) => (response.ok ? response.json() : null))
        .then((data) => {
          const usage = bar.querySelector('[data-revision-usage]');
          if (!usage || !data?.revision) return;
          usage.textContent = `${data.revision.used}/${data.revision.limit} used`;
        })
        .catch(() => {});
    }
  }
</script>

<style>
  :global(body:has(.preview-sales-bar)) {
    padding-bottom: 96px;
  }

  .preview-sales-bar {
    position: fixed;
    z-index: 80;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 0 1.4rem 1.05rem;
    background: transparent;
    color: #17191c;
    pointer-events: none;
  }

  .preview-sales-inner {
    display: grid;
    grid-template-columns: 244px minmax(230px, 1.2fr) minmax(230px, 1.2fr) minmax(210px, 1fr) auto auto;
    max-width: 1220px;
    min-height: 70px;
    align-items: stretch;
    justify-content: stretch;
    gap: 0;
    margin: 0 auto;
    border: 2px solid #17191c;
    border-radius: 0;
    padding: 0;
    background: #fffcf7;
    box-shadow: 8px 8px 0 #17191c;
    pointer-events: auto;
  }

  .preview-sales-copy {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.58rem;
    min-height: 68px;
    border-right: 2px solid #17191c;
    padding: 0 1.45rem;
  }

  .preview-sales-mark {
    position: relative;
    display: inline-flex;
    width: 32px;
    height: 38px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    background: #ff5a3d;
    clip-path: path("M16 0C7.2 0 0 7.1 0 15.9c0 11.9 16 22.1 16 22.1s16-10.2 16-22.1C32 7.1 24.8 0 16 0Z");
  }

  .preview-sales-mark::before {
    content: "";
    width: 12px;
    height: 12px;
    border: 4px solid #fffcf7;
    border-radius: 999px;
  }

  .preview-sales-brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #17191c;
    font-family: Inter, Manrope, ui-sans-serif, system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 950;
    line-height: 1;
    letter-spacing: 0;
  }

  .preview-sales-actions {
    display: contents;
  }

  .preview-sales-plan,
  .preview-sales-link,
  .preview-sales-checkout {
    display: inline-flex;
    min-height: 68px;
    align-items: center;
    justify-content: center;
    border-right: 2px solid #17191c;
    border-radius: 0;
    font-family: Inter, Manrope, ui-sans-serif, system-ui, sans-serif;
    text-decoration: none;
    white-space: nowrap;
  }

  .is-hidden {
    display: none !important;
  }

  .preview-sales-plan {
    flex-direction: column;
    align-items: flex-start;
    padding: 0.78rem 0.95rem;
    color: #17191c;
  }

  .preview-sales-plan-featured {
    background: #cdeccf;
  }

  .preview-sales-plan span {
    font-size: 0.96rem;
    font-weight: 950;
    line-height: 1;
  }

  .preview-sales-plan small {
    margin-top: 0.34rem;
    color: #5e6268;
    font-size: 0.76rem;
    font-weight: 850;
    line-height: 1.1;
  }

  .preview-sales-link {
    padding: 0 1.05rem;
    color: #17191c;
    font-size: 0.78rem;
    font-weight: 950;
    text-decoration: none;
  }

  .preview-sales-link:hover {
    background: #fff6ec;
  }

  .preview-sales-checkout {
    min-width: 126px;
    margin: 0.74rem 0.74rem 0.74rem 0.74rem;
    border: 0;
    background: #ff5a3d;
    color: #fffcf7;
    font-size: 0.9rem;
    font-weight: 950;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    box-shadow: 6px 6px 0 #17191c;
  }

  @media (max-width: 680px) {
    :global(body:has(.preview-sales-bar)) {
      padding-bottom: 94px;
    }

    .preview-sales-bar {
      padding: 0 0.65rem 0.75rem;
    }

    .preview-sales-inner {
      display: flex;
      max-width: 100%;
      min-height: 66px;
      overflow-x: auto;
      scroll-snap-type: x proximity;
    }

    .preview-sales-copy,
    .preview-sales-plan,
    .preview-sales-link,
    .preview-sales-checkout {
      flex: 0 0 auto;
      min-height: 66px;
      scroll-snap-align: start;
    }

    .preview-sales-copy {
      min-width: 180px;
      padding-inline: 1rem;
    }

    .preview-sales-plan {
      min-width: 230px;
    }

    .preview-sales-link {
      min-width: 116px;
      padding-inline: 0.9rem;
    }

    .preview-sales-checkout {
      min-width: 118px;
      margin: 0.62rem;
      min-height: 42px;
    }
  }
</style>
