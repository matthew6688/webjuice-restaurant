---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  businessName?: string;
}

const {
  title,
  description = 'ProfitsLocal website preview support',
  businessName = '',
} = Astro.props;

const officialSite = 'https://profitslocal.com/';
const logoUrl = 'https://profitslocal.com/brand/logo-horizontal.svg';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
</head>
<body class="profitslocal-funnel">
  <div class="pl-page-shell">
    <header class="pl-topbar">
      <nav class="pl-nav" aria-label="ProfitsLocal preview support">
        <a class="pl-brand" href={officialSite} target="_blank" rel="noreferrer" aria-label="Open ProfitsLocal website">
          <img src={logoUrl} alt="profitslocal" />
        </a>
        <div class="pl-nav-links">
          <a href="/demo-faq" data-carry-context>How it works</a>
          <a href="/demo-faq#pricing" data-carry-context>Pricing</a>
          <a href="/demo-faq#questions" data-carry-context>FAQ</a>
          <a href="/contact-us" data-carry-context>Contact</a>
        </div>
        <a class="pl-nav-cta" href="/checkout" data-carry-context>Checkout</a>
      </nav>
    </header>

    <main>
      {businessName && <p class="pl-project-label">Preview project / {businessName}</p>}
      <slot />
    </main>

    <footer class="pl-footer">
      <div>
        <a class="pl-footer-brand" href={officialSite} target="_blank" rel="noreferrer">
          <img src={logoUrl} alt="profitslocal" />
        </a>
        <p>Preview, payment, revision, approval, and domain launch support for small-business websites.</p>
      </div>
      <nav aria-label="ProfitsLocal support links">
        <a href="/demo-faq" data-carry-context>How it works</a>
        <a href="/domain-help" data-carry-context>Domain guide</a>
        <a href="/contact-us" data-carry-context>Contact</a>
        <a href="mailto:hello@fengtalk.ai">hello@fengtalk.ai</a>
      </nav>
    </footer>
  </div>
</body>
</html>

<script>
  const carryKeys = ['client_slug', 'repo', 'template', 'preview_url', 'order_id', 'session_id', 'email', 'tier'];
  const currentParams = new URLSearchParams(window.location.search);
  const carried = new URLSearchParams();
  carryKeys.forEach((key) => {
    const value = currentParams.get(key);
    if (value) carried.set(key, value);
  });
  if (carried.size) {
    document.querySelectorAll('a[data-carry-context]').forEach((link) => {
      const anchor = link;
      const url = new URL(anchor.getAttribute('href') || '/', window.location.origin);
      carried.forEach((value, key) => {
        if (!url.searchParams.has(key)) url.searchParams.set(key, value);
      });
      anchor.setAttribute('href', `${url.pathname}${url.search}${url.hash}`);
    });
  }
</script>

<style is:global>
  .profitslocal-funnel {
    --pl-cream: #fff6ec;
    --pl-paper: #fffcf7;
    --pl-ink: #17191c;
    --pl-muted: #5e6268;
    --pl-coral: #ff5a3d;
    --pl-mint: #cdeccf;
    min-height: 100vh;
    margin: 0;
    background:
      linear-gradient(rgba(23, 25, 28, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(23, 25, 28, 0.035) 1px, transparent 1px),
      var(--pl-cream);
    background-size: 26px 26px;
    color: var(--pl-ink);
    font-family:
      Inter,
      Manrope,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    letter-spacing: 0;
  }

  .profitslocal-funnel a {
    color: inherit;
  }

  .pl-page-shell {
    width: min(1240px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .pl-topbar {
    padding: 1rem 0 0;
  }

  .pl-nav {
    display: grid;
    grid-template-columns: 220px 1fr auto;
    align-items: center;
    min-height: 70px;
    border: 2px solid var(--pl-ink);
    background: var(--pl-paper);
    box-shadow: 6px 6px 0 var(--pl-ink);
  }

  .pl-brand,
  .pl-footer-brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .pl-brand {
    height: 100%;
    border-right: 2px solid var(--pl-ink);
    padding: 0 1.5rem;
  }

  .pl-brand img {
    width: 148px;
    height: auto;
  }

  .pl-nav-links {
    display: flex;
    align-items: stretch;
    justify-content: flex-end;
    height: 100%;
  }

  .pl-nav-links a,
  .pl-nav-cta {
    display: inline-flex;
    min-height: 68px;
    align-items: center;
    justify-content: center;
    border-left: 2px solid var(--pl-ink);
    padding: 0 1.1rem;
    font-size: 0.85rem;
    font-weight: 950;
    text-decoration: none;
    white-space: nowrap;
  }

  .pl-nav-links a:hover {
    background: var(--pl-mint);
  }

  .pl-nav-cta {
    margin: 0.65rem;
    min-height: 46px;
    border: 0;
    background: var(--pl-coral);
    color: var(--pl-paper);
    box-shadow: 5px 5px 0 var(--pl-ink);
    text-transform: uppercase;
  }

  .profitslocal-funnel main {
    padding: clamp(2rem, 4vw, 4.5rem) 0;
  }

  .pl-project-label {
    width: fit-content;
    margin: 0 0 1.25rem;
    border: 2px solid var(--pl-ink);
    background: var(--pl-mint);
    padding: 0.5rem 0.7rem;
    color: var(--pl-ink);
    font-size: 0.74rem;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pl-footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    border-top: 2px solid var(--pl-ink);
    padding: 1.5rem 0 2.1rem;
    color: var(--pl-muted);
    font-size: 0.92rem;
  }

  .pl-footer-brand img {
    width: 150px;
    height: auto;
  }

  .pl-footer p {
    max-width: 560px;
    margin: 0.8rem 0 0;
    line-height: 1.55;
  }

  .pl-footer nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.55rem;
  }

  .pl-footer nav a {
    border: 1px solid rgba(23, 25, 28, 0.3);
    background: var(--pl-paper);
    padding: 0.55rem 0.65rem;
    color: var(--pl-ink);
    font-weight: 850;
    text-decoration: none;
  }

  @media (max-width: 880px) {
    .pl-nav {
      grid-template-columns: 1fr;
    }

    .pl-brand {
      min-height: 64px;
      border-right: 0;
      border-bottom: 2px solid var(--pl-ink);
    }

    .pl-nav-links {
      overflow-x: auto;
      justify-content: flex-start;
    }

    .pl-nav-links a:first-child {
      border-left: 0;
    }

    .pl-nav-cta {
      width: fit-content;
    }

    .pl-footer {
      grid-template-columns: 1fr;
    }

    .pl-footer nav {
      justify-content: flex-start;
    }
  }
</style>
