---
import FunnelLayout from '../layouts/FunnelLayout.astro';
import { loadCheckoutArtifact, loadRestaurantContent } from '../lib/restaurantArtifacts';

const content = loadRestaurantContent();
const checkout = loadCheckoutArtifact();
const oneTime = (checkout.tiers || []).find((tier: any) => tier.id === 'one_time') || { amount: 399 };
const yearly = (checkout.tiers || []).find((tier: any) => tier.id === 'yearly_maintenance') || { amount: 799 };
const previewUrl = checkout.hiddenFields?.preview_url || '';
const checkoutUrl = oneTime.purchaseUrl || '/checkout?tier=one_time';
const yearlyUrl = yearly.purchaseUrl || '/checkout?tier=yearly_maintenance';
---

<FunnelLayout title={`How this preview works - ${content.hero.name}`} description="Preview purchase details and next steps" businessName={content.hero.name}>
  <section class="funnel-shell">
    <p class="eyebrow">Preview ready</p>
    <h1>Make this preview your working website.</h1>
    <p class="lede">
      Keep the design direction, send the changes you need, then approve the version that should go live on your domain.
    </p>

    <div class="trust-strip" aria-label="What is included">
      <span>Secure Stripe checkout</span>
      <span>Dev preview first</span>
      <span>Domain guidance included</span>
    </div>

    <div class="offer-grid" id="pricing">
      <article class="offer primary">
        <span>Most owners start here</span>
        <h2>${oneTime.amount}</h2>
        <p>One-time website build with 3 revision rounds, hosting, and a free ProfitsLocal subdomain if you want the fastest launch path.</p>
        <a href={checkoutUrl}>Claim for ${oneTime.amount}</a>
      </article>
      <article class="offer">
        <span>Managed care</span>
        <h2>${yearly.amount}/yr</h2>
        <p>Website build plus monthly maintenance for menu, photo, hours, copy, and light SEO updates across the year.</p>
        <a href={yearlyUrl}>Choose yearly care</a>
      </article>
    </div>

    <div class="process">
      <article>
        <span>01</span>
        <h2>Claim the preview</h2>
        <p>Choose a package and add your email, preferred domain, and launch notes.</p>
      </article>
      <article>
        <span>02</span>
        <h2>We polish the dev site</h2>
        <p>We work on the preview version first, so your current site is not touched during review.</p>
      </article>
      <article>
        <span>03</span>
        <h2>You review with control</h2>
        <p>Your order ID and checkout email unlock revisions, approval, and status links.</p>
      </article>
      <article>
        <span>04</span>
        <h2>We guide launch</h2>
        <p>Use a free ProfitsLocal subdomain, your own subdomain, or your root domain with DNS steps.</p>
      </article>
    </div>

    <section class="faq" id="questions">
      <h2>Questions owners usually ask</h2>
      <details open>
        <summary>Will my phone, address, menu, or booking link stay accurate?</summary>
        <p>Yes. Core business facts are checked against source evidence before review. If something is uncertain, we ask before treating it as final.</p>
      </details>
      <details>
        <summary>Can I ask for changes before launch?</summary>
        <p>Yes. The one-time package includes 3 revision rounds. Extra rounds are available for $100 each after the included quota is used.</p>
      </details>
      <details>
        <summary>What if I already have a website?</summary>
        <p>We preserve important content, logo/favicon intent, contact paths, SEO basics, and old URL intent where possible. The dev preview stays separate until approval.</p>
      </details>
      <details>
        <summary>What happens after payment?</summary>
        <p>You land on a thank-you page with domain setup, revision, and approval links. We also email the same core order information.</p>
      </details>
      <details>
        <summary>Can I use my own domain?</summary>
        <p>Yes. We support a free ProfitsLocal subdomain, a subdomain on your domain, or a root domain. Root domains may need a short DNS review first.</p>
      </details>
    </section>

    <div class="cta-panel">
      <div>
        <p class="eyebrow">Ready to claim</p>
        <h2>{content.hero.name}</h2>
        {previewUrl && <p>Current preview: <a href={previewUrl}>{previewUrl}</a></p>}
      </div>
      <a href={checkoutUrl}>Claim this preview</a>
    </div>
  </section>
</FunnelLayout>

<style>
  .funnel-shell {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 6rem) 0;
  }

  .eyebrow,
  .process article > span,
  .offer > span {
    color: #ff5a3d;
    font-size: 0.74rem;
    font-weight: 950;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 900px;
    margin-top: 0.8rem;
    color: #17191c;
    font-size: clamp(3rem, 8vw, 6.7rem);
    font-weight: 950;
    line-height: 0.9;
  }

  .lede {
    max-width: 700px;
    margin-top: 1.3rem;
    color: #5e6268;
    font-size: 1.12rem;
    line-height: 1.75;
  }

  .trust-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    width: fit-content;
    margin-top: 1.6rem;
    border: 2px solid #17191c;
    background: #17191c;
    box-shadow: 5px 5px 0 #17191c;
  }

  .trust-strip span {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    background: #fffcf7;
    padding: 0 0.82rem;
    color: #17191c;
    font-size: 0.78rem;
    font-weight: 950;
    white-space: nowrap;
  }

  .offer-grid,
  .process {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 3rem;
    border: 2px solid #17191c;
    background: #17191c;
    box-shadow: 6px 6px 0 #17191c;
  }

  .offer,
  .process article,
  .faq,
  .cta-panel {
    background: #fffcf7;
  }

  .offer,
  .process article {
    padding: clamp(1.2rem, 3vw, 2rem);
  }

  .offer.primary {
    background: #cdeccf;
    color: #17191c;
  }

  .offer h2 {
    margin: 0.7rem 0;
    font-size: clamp(3rem, 7vw, 5.6rem);
    font-weight: 950;
    line-height: 0.9;
  }

  .offer p,
  .process p,
  .faq p,
  .cta-panel p {
    color: #5e6268;
    line-height: 1.65;
  }

  .offer.primary p {
    color: #3e444b;
  }

  .offer a,
  .cta-panel > a {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1.2rem;
    padding: 0.85rem 1.1rem;
    border: 2px solid #17191c;
    background: #ff5a3d;
    color: #fffcf7;
    box-shadow: 5px 5px 0 #17191c;
    font-weight: 950;
    text-decoration: none;
  }

  .process h2,
  .faq h2,
  .cta-panel h2 {
    margin-top: 0.75rem;
    color: #17191c;
    font-size: 1.35rem;
    font-weight: 950;
  }

  .faq {
    margin-top: 3rem;
    border: 2px solid #17191c;
    padding: clamp(1.2rem, 3vw, 2rem);
    box-shadow: 6px 6px 0 #17191c;
  }

  details {
    border-top: 1px solid rgba(23, 25, 28, 0.22);
    padding: 1rem 0;
  }

  summary {
    cursor: pointer;
    color: #17191c;
    font-weight: 950;
  }

  .cta-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.2rem;
    border: 2px solid #17191c;
    padding: clamp(1.2rem, 3vw, 2rem);
    box-shadow: 6px 6px 0 #17191c;
  }

  .cta-panel a {
    overflow-wrap: anywhere;
    color: inherit;
  }

  @media (max-width: 720px) {
    .offer-grid,
    .process {
      grid-template-columns: 1fr;
    }

    .cta-panel {
      display: grid;
    }
  }
</style>
