---
import Layout from '../layouts/Layout.astro';
import {
  firstImage,
  loadRestaurantContent,
  loadRestaurantDesign,
  paletteVars,
  supportingImages,
} from '../lib/restaurantArtifacts';

const content = loadRestaurantContent();
const design = loadRestaurantDesign();
const styles = paletteVars(design);
const heroImage = firstImage(content);
const supportImages = supportingImages(content);
const sections = content.menu?.sections || [];
const featuredItems = sections.flatMap((section: any) => section.items || []).slice(0, 6);
const hasMenu = sections.length > 0;
const logo = content.brand?.logo || '';
---

<Layout title={content.hero.name + ' Menu & Dining'} description={content.hero.tagline} brandName={content.hero.name}>
  <section class="restaurant-shell" style={styles}>
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="source-pill">Google Places + official menu</p>
        {logo && <img src={logo} alt={`${content.hero.name} logo`} class="brand-logo" />}
        <h1>{content.hero.name}</h1>
        <p class="tagline">{content.hero.tagline}</p>
        <div class="actions">
          {hasMenu && <a href="/menu" class="button button-primary">View menu</a>}
          {content.cta.reserveUrl && <a href={content.cta.reserveUrl} class="button button-accent">Reserve</a>}
          {content.cta.callUrl && <a href={content.cta.callUrl} class="button button-light">Call</a>}
          {content.cta.mapUrl && <a href={content.cta.mapUrl} class="button button-light">Navigate</a>}
        </div>
      </div>

      <div class="image-board" aria-label={`${content.hero.name} gallery`}>
        {heroImage
          ? <img src={heroImage} alt={`${content.hero.name} food or venue`} class="hero-photo" />
          : <div class="image-placeholder">Photo pending</div>}
        <div class="image-row">
          {supportImages.map((image: string) => (
            <img src={image} alt={`${content.hero.name} gallery image`} />
          ))}
        </div>
      </div>
    </div>

    <div class="fact-grid">
      <a class="fact-card" href={content.cta.mapUrl || undefined}>
        <span>Address</span>
        <strong>{content.contact.address || 'Address pending'}</strong>
      </a>
      <a class="fact-card" href={content.cta.callUrl || undefined}>
        <span>Phone</span>
        <strong>{content.contact.phone || 'Phone pending'}</strong>
      </a>
      <a class="fact-card" href={content.contact.website || undefined}>
        <span>Website</span>
        <strong>{content.contact.website ? 'Official site' : 'Website pending'}</strong>
      </a>
      <div class="fact-card">
        <span>Rating</span>
        <strong>{content.hero.rating ? `${content.hero.rating}/5 · ${content.hero.reviewCount} reviews` : 'Rating pending'}</strong>
      </div>
    </div>
  </section>

  <section class="menu-preview">
    <div class="section-heading">
      <div>
        <p>Signature picks</p>
        <h2>Real menu highlights</h2>
      </div>
      {hasMenu && <a href="/menu">Full menu</a>}
    </div>
    <div class="menu-grid">
      {featuredItems.map((item: any) => (
        <article class="menu-card">
          <div>
            <h3>{item.name}</h3>
            {item.description && <p>{item.description}</p>}
          </div>
          {item.price && <strong>{item.price}</strong>}
        </article>
      ))}
      {!featuredItems.length && (
        <article class="menu-card menu-card-empty">
          <h3>Menu artifact required</h3>
          <p>Add content.restaurant.json with menu.sections before sending this preview.</p>
        </article>
      )}
    </div>
  </section>
</Layout>

<style>
  .restaurant-shell {
    background: var(--wj-bg);
    color: var(--wj-ink);
    border-radius: 8px;
    padding: clamp(1.25rem, 4vw, 3rem);
  }

  .hero-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .source-pill {
    display: inline-flex;
    border: 1px solid color-mix(in srgb, var(--wj-accent), white 58%);
    border-radius: 999px;
    padding: 0.45rem 0.9rem;
    color: var(--wj-accent);
    background: color-mix(in srgb, var(--wj-surface), transparent 10%);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .brand-logo {
    display: block;
    width: min(260px, 76vw);
    max-height: 92px;
    object-fit: contain;
    object-position: left center;
    margin: 1.5rem 0;
  }

  h1 {
    max-width: 760px;
    font-size: clamp(3rem, 8vw, 5.8rem);
    line-height: 0.92;
    font-weight: 900;
    letter-spacing: 0;
  }

  .tagline {
    max-width: 560px;
    margin-top: 1.4rem;
    color: var(--wj-muted);
    font-size: 1.2rem;
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.75rem 1.3rem;
    font-weight: 800;
    text-decoration: none;
  }

  .button-primary {
    background: var(--wj-ink);
    color: var(--wj-surface);
  }

  .button-accent {
    background: var(--wj-accent);
    color: white;
  }

  .button-light {
    border: 1px solid color-mix(in srgb, var(--wj-muted), white 58%);
    color: var(--wj-ink);
    background: color-mix(in srgb, var(--wj-surface), transparent 16%);
  }

  .image-board {
    display: grid;
    gap: 1rem;
  }

  .hero-photo,
  .image-placeholder {
    width: 100%;
    aspect-ratio: 1.18;
    border-radius: 8px;
    object-fit: cover;
  }

  .image-placeholder {
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--wj-muted), white 65%);
    color: var(--wj-ink);
    font-weight: 800;
  }

  .image-row {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }

  .image-row img {
    width: 31%;
    aspect-ratio: 0.82;
    border-radius: 8px;
    object-fit: cover;
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.16);
  }

  .fact-grid {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, 6vw, 5rem);
  }

  .fact-card {
    display: grid;
    gap: 0.55rem;
    min-height: 120px;
    border: 1px solid color-mix(in srgb, var(--wj-muted), white 65%);
    border-radius: 8px;
    padding: 1.2rem;
    background: color-mix(in srgb, var(--wj-surface), transparent 8%);
    color: var(--wj-ink);
    text-decoration: none;
  }

  .fact-card span,
  .section-heading p {
    color: var(--wj-accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .fact-card strong {
    font-size: 1.05rem;
    line-height: 1.45;
  }

  .menu-preview {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .section-heading h2 {
    margin-top: 0.35rem;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    letter-spacing: 0;
  }

  .section-heading a {
    color: var(--wj-ink);
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .menu-grid {
    display: grid;
    gap: 1rem;
  }

  .menu-card {
    display: flex;
    min-height: 150px;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid #ded8cf;
    border-radius: 8px;
    padding: 1.35rem;
    background: white;
  }

  .menu-card h3 {
    font-size: 1.15rem;
    font-weight: 900;
    line-height: 1.35;
  }

  .menu-card p {
    margin-top: 0.8rem;
    color: #675c52;
    line-height: 1.55;
  }

  .menu-card strong {
    color: var(--wj-accent);
    font-weight: 900;
    white-space: nowrap;
  }

  .menu-card-empty {
    display: block;
  }

  @media (min-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr 0.86fr;
    }

    .fact-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .menu-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
