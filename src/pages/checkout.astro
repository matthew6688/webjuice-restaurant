---
import FunnelLayout from '../layouts/FunnelLayout.astro';
import { loadCheckoutArtifact, loadRestaurantContent } from '../lib/restaurantArtifacts';

const content = loadRestaurantContent();
const checkout = loadCheckoutArtifact();
const tiers = checkout.tiers || [];
const oneTime = tiers.find((tier: any) => tier.id === 'one_time') || { id: 'one_time', amount: 399 };
const yearly = tiers.find((tier: any) => tier.id === 'yearly_maintenance') || { id: 'yearly_maintenance', amount: 799 };
---

<FunnelLayout title={`Checkout - ${content.hero.name}`} description="Claim this website preview" businessName={content.hero.name}>
  <section class="checkout-shell">
    <p class="eyebrow">Secure checkout</p>
    <h1>{content.hero.name}</h1>
    <p class="lede">Choose a package, tell us where the site should launch, and add the first changes you already know you want.</p>
    <p class="context-note" data-preview-context>
      This checkout is linked to the exact preview you just viewed, so payment, revisions, domain setup, and approval all map back to the right project.
    </p>

    <form class="checkout-form" data-checkout-form>
      <input type="hidden" name="client_slug" value={checkout.hiddenFields?.client_slug || checkout.clientSlug || ''} />
      <input type="hidden" name="repo" value={checkout.hiddenFields?.repo || ''} />
      <input type="hidden" name="template" value={checkout.hiddenFields?.template || 'webjuice-restaurant'} />
      <input type="hidden" name="preview_url" value={checkout.hiddenFields?.preview_url || ''} />
      <input type="hidden" name="order_id" value="" />

      <label>
        Package
        <select name="tier" required>
          <option value="one_time">$399 one-time website with 3 revisions</option>
          <option value="yearly_maintenance">$799/year website with monthly maintenance</option>
          <option value="extra_revision">$100 extra revision</option>
        </select>
        <small>Most businesses choose the $399 package first. Choose yearly if you want ongoing monthly updates.</small>
      </label>

      <label>
        Business name
        <input name="business_name" required value={content.hero.name} />
      </label>

      <label>
        Email
        <input name="email" type="email" required placeholder="owner@example.com" />
      </label>

      <label>
        Preferred domain or subdomain
        <input name="preferred_domain" placeholder="yourbusiness.com or menu.yourbusiness.com" />
        <small>Leave blank if you want us to start with a free ProfitsLocal subdomain.</small>
      </label>

      <label class="wide">
        Launch notes or requested changes
        <textarea name="launch_notes" rows="5" placeholder="Examples: update opening hours, replace a photo, use my own domain, adjust menu wording, change the booking link."></textarea>
      </label>

      <button type="submit">Continue to secure payment</button>
      <p class="status" data-status></p>
    </form>
  </section>
</FunnelLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const form = document.querySelector('[data-checkout-form]');
  const status = document.querySelector('[data-status]');
  const tier = params.get('tier');
  const orderId = params.get('order_id') || params.get('session_id') || '';
  if (tier && form?.elements?.tier) form.elements.tier.value = tier;
  if (orderId && form?.elements?.order_id) form.elements.order_id.value = orderId;
  ['client_slug', 'repo', 'template', 'preview_url'].forEach((key) => {
    const value = params.get(key);
    if (value && form?.elements?.[key]) form.elements[key].value = value;
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    status.textContent = 'Opening secure checkout...';
    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());
    const response = await fetch('/api/create-checkout-session/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const data = await response.json();
    if (!response.ok || !data.url) {
      status.textContent = data.error || 'Checkout is not configured yet.';
      return;
    }
    window.location.href = data.url;
  });
</script>

<style>
  .checkout-shell {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 6rem) 0;
  }

  .eyebrow {
    color: #ff5a3d;
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: 0.8rem;
    color: #17191c;
    font-size: clamp(3rem, 8vw, 6.2rem);
    font-weight: 950;
    line-height: 0.9;
  }

  .lede,
  .context-note {
    max-width: 660px;
    margin-top: 1.2rem;
    color: #5e6268;
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .context-note {
    border-left: 5px solid #ff5a3d;
    background: #fffcf7;
    padding: 0.9rem 1rem;
    font-size: 0.95rem;
    font-weight: 850;
  }

  .checkout-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
    border: 2px solid #17191c;
    padding: clamp(1rem, 3vw, 2rem);
    background: #fffcf7;
    box-shadow: 6px 6px 0 #17191c;
  }

  label {
    display: grid;
    gap: 0.45rem;
    color: #17191c;
    font-weight: 900;
  }

  label small {
    color: #5e6268;
    font-size: 0.78rem;
    font-weight: 750;
    line-height: 1.4;
  }

  .wide,
  button,
  .status {
    grid-column: 1 / -1;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 2px solid rgba(23, 25, 28, 0.26);
    border-radius: 0;
    padding: 0.82rem 0.9rem;
    color: #17191c;
    font: inherit;
    font-weight: 600;
  }

  button {
    min-height: 52px;
    border: 2px solid #17191c;
    border-radius: 0;
    background: #ff5a3d;
    color: #fffcf7;
    box-shadow: 5px 5px 0 #17191c;
    font-weight: 950;
    cursor: pointer;
  }

  .status {
    margin: 0;
    color: #5e6268;
    font-weight: 800;
  }

  @media (max-width: 720px) {
    .checkout-form {
      grid-template-columns: 1fr;
    }
  }
</style>
