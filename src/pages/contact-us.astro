---
import FunnelLayout from '../layouts/FunnelLayout.astro';
import { loadCheckoutArtifact, loadRestaurantContent } from '../lib/restaurantArtifacts';

const content = loadRestaurantContent();
const checkout = loadCheckoutArtifact();
const supportEmail = 'hello@fengtalk.ai';
const previewUrl = checkout.hiddenFields?.preview_url || '';
---

<FunnelLayout title={`Contact ProfitsLocal - ${content.hero.name}`} description="Contact ProfitsLocal about this website preview" businessName={content.hero.name}>
  <section class="contact-shell">
    <p class="eyebrow">Questions before checkout</p>
    <h1>Talk to ProfitsLocal about this preview.</h1>
    <p class="lede">
      Ask about pricing, domain setup, timeline, revisions, or what happens after payment. We keep the preview context attached so we know exactly which demo you mean.
    </p>

    <div class="contact-grid">
      <section class="contact-panel">
        <h2>Direct contact</h2>
        <a class="contact-line" href={`mailto:${supportEmail}`}>{supportEmail}</a>
        <a class="contact-line" href={`mailto:${supportEmail}?subject=${encodeURIComponent(`Call request for ${content.hero.name}`)}`}>Request a callback by email</a>
        <p>Include your phone number and best time to call. We will reply with next steps for this exact preview.</p>
      </section>

      <form class="contact-form" data-contact-form>
        <input type="hidden" name="client_slug" value={checkout.hiddenFields?.client_slug || checkout.clientSlug || ''} />
        <input type="hidden" name="repo" value={checkout.hiddenFields?.repo || ''} />
        <input type="hidden" name="preview_url" value={previewUrl} />

        <label>
          Business
          <input name="business_name" required value={content.hero.name} />
        </label>
        <label>
          Your email
          <input name="email" type="email" required placeholder="owner@example.com" />
        </label>
        <label>
          Phone number
          <input name="phone" type="tel" placeholder="+61 ..." />
        </label>
        <label>
          Question
          <textarea name="message" rows="5" required placeholder="Tell us what you want to know before claiming this preview."></textarea>
        </label>
        <button type="submit">Email ProfitsLocal</button>
      </form>
    </div>

    <aside class="context-card" data-preview-context>
      <span>Attached preview context</span>
      <p>Client: {checkout.hiddenFields?.client_slug || checkout.clientSlug || content.hero.name}</p>
      {previewUrl && <p>Preview: <a href={previewUrl}>{previewUrl}</a></p>}
      {checkout.hiddenFields?.repo && <p>Repo: {checkout.hiddenFields.repo}</p>}
    </aside>
  </section>
</FunnelLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const contactForm = document.querySelector('[data-contact-form]');
  ['client_slug', 'repo', 'preview_url'].forEach((key) => {
    const value = params.get(key);
    if (value && contactForm?.elements?.[key]) contactForm.elements[key].value = value;
  });

  contactForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = Object.fromEntries(new FormData(contactForm).entries());
    const subject = `Question about ${data.business_name || 'website preview'}`;
    const body = [
      `Business: ${data.business_name || ''}`,
      `Email: ${data.email || ''}`,
      `Phone: ${data.phone || ''}`,
      `Client slug: ${data.client_slug || ''}`,
      `Repo: ${data.repo || ''}`,
      `Preview URL: ${data.preview_url || window.location.origin}`,
      '',
      'Question:',
      data.message || '',
    ].join('\n');
    window.location.href = `mailto:hello@fengtalk.ai?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .contact-shell {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 6rem) 0;
  }

  .eyebrow {
    color: #ff5a3d;
    font-size: 0.75rem;
    font-weight: 950;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 880px;
    margin-top: 0.8rem;
    color: #17191c;
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 950;
    line-height: 0.9;
  }

  .lede {
    max-width: 720px;
    margin-top: 1.3rem;
    color: #5e6268;
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 1px;
    margin-top: 2.6rem;
    border: 2px solid #17191c;
    background: #17191c;
    box-shadow: 6px 6px 0 #17191c;
  }

  .contact-panel,
  .contact-form,
  .context-card {
    background: #fffcf7;
    padding: clamp(1.2rem, 3vw, 2rem);
  }

  .contact-panel {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  h2 {
    margin: 0;
    color: #17191c;
    font-size: 1.35rem;
    font-weight: 950;
  }

  .contact-line {
    display: inline-flex;
    width: fit-content;
    border: 2px solid #17191c;
    background: #cdeccf;
    padding: 0.75rem 0.85rem;
    color: #17191c;
    font-weight: 950;
    text-decoration: none;
  }

  .contact-panel p,
  .context-card p {
    margin: 0;
    color: #5e6268;
    line-height: 1.65;
  }

  .contact-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  label {
    display: grid;
    gap: 0.45rem;
    color: #17191c;
    font-weight: 900;
  }

  label:has(textarea),
  button {
    grid-column: 1 / -1;
  }

  input,
  textarea {
    width: 100%;
    border: 2px solid rgba(23, 25, 28, 0.26);
    border-radius: 0;
    padding: 0.82rem 0.9rem;
    color: #17191c;
    font: inherit;
    font-weight: 650;
  }

  button {
    min-height: 52px;
    border: 2px solid #17191c;
    background: #ff5a3d;
    color: #fffcf7;
    font-weight: 950;
    cursor: pointer;
    box-shadow: 5px 5px 0 #17191c;
  }

  .context-card {
    margin-top: 1.2rem;
    border: 2px solid #17191c;
    box-shadow: 6px 6px 0 #17191c;
  }

  .context-card span {
    display: block;
    margin-bottom: 0.7rem;
    color: #ff5a3d;
    font-size: 0.75rem;
    font-weight: 950;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .context-card a {
    overflow-wrap: anywhere;
  }

  @media (max-width: 760px) {
    .contact-grid,
    .contact-form {
      grid-template-columns: 1fr;
    }
  }
</style>
